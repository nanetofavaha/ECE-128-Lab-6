
`timescale 1ns / 1ps

module seq_detector_mealy(
    input P1, clk, reset,
    output reg z
);

parameter S0 = 2'd0,
          S1 = 2'd1,
          S2 = 2'd2,
          S3 = 2'd3;

reg [1:0] PS, NS;

// Sequential Logic
always @(posedge clk or posedge reset)
begin
    if (reset)
        PS <= S0;
    else
        PS <= NS;
end

// Next State Logic
always @(*)
begin
    case (PS)
        S0: begin
            if (P1) NS = S1; //1
            else    NS = S0;
        end

        S1: begin
            if (P1) NS = S2; //1
            else    NS = S0;
        end

        S2: begin
            if (!P1) NS = S3; //0
            else    NS = S2;
        end

        S3: begin
            if (P1) NS = S1; //Overlapping, 1
            else    NS = S0;
        end

        default: NS = S0;
    endcase
end

// Mealy Output Logic
always @(*)
begin
    case (PS)
        S0: z = 0;
        S1: z = 0;
        S2: z = 0;

        S3: begin
            if (P1)
                z = 1;
            else
                z = 0;
        end

        default: z = 0;
    endcase
end

endmodule


