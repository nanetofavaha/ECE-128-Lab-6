`timescale 1ns / 1ps

module seq_detector(
input P1,clk,reset, 
output reg z
);

parameter S0 = 3'd0,
          S1 = 3'd1,
          S2 = 3'd2,
          S3 = 3'd3,
          S4 = 3'd4;

reg [2:0] PS, NS;

always@(posedge clk or posedge reset)
begin
   if(reset)
PS <= S0;
   else
PS <= NS ;
end


always @(*) begin
    case (PS)
        S0: begin
            if (P1) NS = S1; //1
            else    NS = S0;
        end

        S1: begin
            if (P1) NS = S2; //1
            else    NS = S0;
        end

        S2: begin
            if (!P1) NS = S3; //0
            else    NS = S2;
        end

        S3: begin
            if (!P1) NS = S4;
            else    NS = S1;
        end

        S4: begin
            if (P1) NS = S1;   // overlapping
            else    NS = S0;   // overlapping
        end

        default: NS = S0;
    endcase
end

always @(*) begin
    case (PS)
        S0: z = 0;
        S1: z = 0;
        S2: z = 0;
        S3: z = 0;
        S4: z = 1;
        default: z = 0;
    endcase
end

endmodule
